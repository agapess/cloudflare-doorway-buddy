{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-doorway-buddy",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // main is resolved by @cloudflare/vite-plugin during build — do NOT deploy from this file directly.
  // Use: wrangler deploy --config dist/server/wrangler.json
  "main": "src/server.ts",
}
